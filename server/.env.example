NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017/alumni_management_db

# JWT Secrets
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_change_in_production_32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_in_production_32chars
JWT_REFRESH_EXPIRES_IN=7d
JWT_VERIFICATION_SECRET=verification_secret_key_change_in_production
JWT_RESET_SECRET=password_reset_secret_key_change_in_production

# Email Service (SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="University Alumni Association <no-reply@alumni.university.edu>"

# Cloud Storage (Optional / Extensible)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
